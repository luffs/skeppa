# Skeppa configuration. On a server these lines belong in ~/.skeppa/config
# (written by scripts/install.js; path overridable with SKEPPA_CONFIG) — a
# fixed home that applies no matter which checkout of the panel is running.
# A .env in the repo root works too: Bun loads it into the process env, which
# overrides the config file per key — best kept for development only.
#
# Everything commented out below shows its default. `~/` works in paths.

NODE_ENV=production

# Where skeppa.db lives. Set it absolute on a server — the code default
# follows the running checkout, which moves when the panel deploys itself.
DATA_DIR=/srv/skeppa/data

# Master key file: 64 hex chars, chmod 600, outside the repo, DATA_DIR and
# APPS_DIR. Generate with:
#   mkdir -p ~/.skeppa && openssl rand -hex 32 > ~/.skeppa/master.key && chmod 600 ~/.skeppa/master.key
# A master.key next to the config file is found automatically — only set this
# when the key lives elsewhere.
# MASTER_KEY_FILE=~/.skeppa/master.key

# Dev-only alternative: the key straight in the environment. Ignored when a
# key file is found.
# MASTER_KEY=

# Panel port (behind your HTTPS reverse proxy).
# PORT=3000

# Workspace root for deployed apps: APPS_DIR/<slug>/{source,shared}
# APPS_DIR=/srv/apps

# Deploy script timeout in milliseconds.
# DEPLOY_TIMEOUT_MS=600000

# pm2 process name of the panel itself. When a project's pm2 name matches,
# the deploy finalizes before pm2 reload runs detached (so the panel doesn't
# kill its own in-flight deploy when dogfooding).
# SKEPPA_PM2_NAME=skeppa

# Set to false to disable the secure cookie flag in production (e.g. plain
# HTTP on a LAN — not recommended).
# SKEPPA_SECURE_COOKIE=false

# Where deploy scripts run: host (default) or podman — a throwaway rootless
# container per deploy, with only the project's source dir mounted. Requires
# the user podman socket (also used by the per-project container runtime):
#   sudo loginctl enable-linger $(whoami)
#   systemctl --user enable --now podman.socket
# SKEPPA_SANDBOX=podman
# CONTAINER_SOCKET=/run/user/1000/podman/podman.sock   (default: $XDG_RUNTIME_DIR/podman/podman.sock)
# BUILD_IMAGE=docker.io/oven/bun:1                     (default build/run image; override per project)
