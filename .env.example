# Master key for AES-256-GCM encryption of ENV vars and GitHub App secrets at
# rest. Preferred: point MASTER_KEY_FILE at a chmod-600 file holding 64 hex
# chars, outside the repo, DATA_DIR and APPS_DIR — then no deploy, git tree or
# DB backup ever includes it, and it stays out of the process environment.
#   mkdir -p ~/.skeppa && openssl rand -hex 32 > ~/.skeppa/master.key && chmod 600 ~/.skeppa/master.key
MASTER_KEY_FILE=/home/skeppa/.skeppa/master.key

# Dev-only alternative: the key straight in the environment. Ignored when
# MASTER_KEY_FILE is set.
# MASTER_KEY=

PORT=3000
NODE_ENV=production
VITE_SKEPPA_API=http://localhost:3000

# Where skeppa.db lives
DATA_DIR=./data

# Workspace root for deployed apps: APPS_DIR/<slug>/{source,shared}
APPS_DIR=/srv/apps

# Deploy script timeout in milliseconds (default 10 minutes)
DEPLOY_TIMEOUT_MS=600000

# pm2 process name of the panel itself. When a project's pm2 name matches this,
# the deploy finalizes before pm2 reload runs detached (so the panel doesn't
# kill its own in-flight deploy when dogfooding).
SKEPPA_PM2_NAME=skeppa

# Set to false to disable secure cookie flag in production (e.g. if not using HTTPS)
# SKEPPA_SECURE_COOKIE=false
