# Required. 32 bytes hex — generate with: openssl rand -hex 32
# Used for AES-256-GCM encryption of ENV vars and GitHub App secrets at rest.
MASTER_KEY=

PORT=3000
NODE_ENV=production

# Where skeppa.db lives
DATA_DIR=./data

# Workspace root for deployed apps: APPS_DIR/<slug>/{source,shared}
APPS_DIR=/srv/apps

# Deploy script timeout in milliseconds (default 10 minutes)
DEPLOY_TIMEOUT_MS=600000

# pm2 process name of the panel itself. When a project's pm2 name matches this,
# the deploy finalizes before pm2 reload runs detached (so the panel doesn't
# kill its own in-flight deploy when dogfooding).
SKEPPA_PM2_NAME=skeppa
